---
import TechIcon from "./icons/TechIcon.astro";
---

<div class="skills-container">
  
  <!-- Skills actuales -->
  <div class="actuales mb-16">
    <h3 class="text-2xl font-bold text-white mb-6 text-center">⚡ Mis Skills</h3>
    <div class="flex flex-wrap justify-center gap-3">
      <span class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm font-medium text-slate-200 backdrop-blur-sm hover:bg-white/10 transition-all duration-300 hover:scale-105">
        <TechIcon name={"html"} class="size-6 text-amber-400" />
        HTML
      </span>
      <span class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm font-medium text-slate-200 backdrop-blur-sm hover:bg-white/10 transition-all duration-300 hover:scale-105">
        <TechIcon name={"css"} class="size-6 text-amber-400" />
        CSS
      </span>
      <span class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm font-medium text-slate-200 backdrop-blur-sm hover:bg-white/10 transition-all duration-300 hover:scale-105">
        <TechIcon name={"js"} class="size-6 text-amber-400" />
        JavaScript
      </span>
      <span class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm font-medium text-slate-200 backdrop-blur-sm hover:bg-white/10 transition-all duration-300 hover:scale-105">
        <TechIcon name={"react"} class="size-6 text-amber-400" />
        React
      </span>
      <span class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm font-medium text-slate-200 backdrop-blur-sm hover:bg-white/10 transition-all duration-300 hover:scale-105">
        <TechIcon name={"astro"} class="size-6 text-amber-400" />
        Astro
      </span>
      <span class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm font-medium text-slate-200 backdrop-blur-sm hover:bg-white/10 transition-all duration-300 hover:scale-105">
        <TechIcon name={"sql"} class="size-6 text-amber-400" />
        SQL
      </span>
      <span class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm font-medium text-slate-200 backdrop-blur-sm hover:bg-white/10 transition-all duration-300 hover:scale-105">
        <TechIcon name={"node"} class="size-6 text-amber-400" />
        Node.js
      </span>
      <span class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm font-medium text-slate-200 backdrop-blur-sm hover:bg-white/10 transition-all duration-300 hover:scale-105">
        <TechIcon name={"express"} class="size-6 text-amber-400" />
        Express
      </span>
      <span class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm font-medium text-slate-200 backdrop-blur-sm hover:bg-white/10 transition-all duration-300 hover:scale-105">
        <TechIcon name={"python"} class="size-6 text-amber-400" />
        Python
      </span>
      <span class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm font-medium text-slate-200 backdrop-blur-sm hover:bg-white/10 transition-all duration-300 hover:scale-105">
        <TechIcon name={"mongo"} class="size-6 text-amber-400" />
        MongoDB
      </span>
      <span class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm font-medium text-slate-200 backdrop-blur-sm hover:bg-white/10 transition-all duration-300 hover:scale-105">
        <TechIcon name={"php"} class="size-6 text-amber-400" />
        PHP
      </span>
    </div>
  </div>

  <!-- Certificaciones y Estudios -->
  <div class="certificaciones">
    <h3 class="text-2xl font-bold text-white mb-8 text-center">🎓 Formación Académica</h3>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
      
      <!-- Tarjeta 1: Ingeniería de Sistemas -->
      <div class="group relative bg-gradient-to-br from-slate-800/50 to-slate-900/50 backdrop-blur-sm border border-white/10 rounded-2xl p-6 hover:border-yellow-400/40 transition-all duration-300 hover:shadow-2xl hover:shadow-yellow-400/5">
        <div class="absolute -top-3 -right-3">
          <div class="w-12 h-12 bg-gradient-to-br from-yellow-400 to-amber-500 rounded-full flex items-center justify-center shadow-lg shadow-yellow-400/20">
            <svg class="w-6 h-6 text-slate-900" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
            </svg>
          </div>
        </div>
        <div class="flex items-start gap-4">
          <div class="flex-1">
            <h4 class="text-lg font-semibold text-white">Ingeniería de Sistemas</h4>
            <p class="text-sm text-yellow-400/80 font-medium">Universidad del Tolima</p>
            <p class="text-xs text-slate-400 mt-1">2024 - Actualidad</p>
          </div>
        </div>
      </div>

      <!-- Tarjeta 2: Tecnólogo ADSO -->
      <div class="group relative bg-gradient-to-br from-slate-800/50 to-slate-900/50 backdrop-blur-sm border border-white/10 rounded-2xl p-6 hover:border-blue-400/40 transition-all duration-300 hover:shadow-2xl hover:shadow-blue-400/5">
        <div class="absolute -top-3 -right-3">
          <div class="w-12 h-12 bg-gradient-to-br from-blue-400 to-cyan-500 rounded-full flex items-center justify-center shadow-lg shadow-blue-400/20">
            <svg class="w-6 h-6 text-slate-900" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
            </svg>
          </div>
        </div>
        <div class="flex items-start gap-4">
          <div class="flex-1">
            <h4 class="text-lg font-semibold text-white">Tecnólogo ADSO</h4>
            <p class="text-sm text-blue-400/80 font-medium">SENA - Centro de Teleinformática</p>
            <p class="text-xs text-slate-400 mt-1">Análisis y Desarrollo de Software</p>
            <span class="inline-block mt-2 px-2 py-0.5 bg-blue-500/20 text-blue-300 text-xs rounded-full border border-blue-500/20">Completado</span>
          </div>
        </div>
      </div>

      <!-- Tarjeta 3: Certificación SENA Calidad -->
      <div class="group relative bg-gradient-to-br from-slate-800/50 to-slate-900/50 backdrop-blur-sm border border-white/10 rounded-2xl p-6 hover:border-green-400/40 transition-all duration-300 hover:shadow-2xl hover:shadow-green-400/5">
        <div class="absolute -top-3 -right-3">
          <div class="w-12 h-12 bg-gradient-to-br from-green-400 to-emerald-500 rounded-full flex items-center justify-center shadow-lg shadow-green-400/20">
            <svg class="w-6 h-6 text-slate-900" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
            </svg>
          </div>
        </div>
        <div class="flex items-start gap-4">
          <div class="flex-1">
            <h4 class="text-lg font-semibold text-white">Certificación Calidad del Software</h4>
            <p class="text-sm text-green-400/80 font-medium">SENA</p>
            <p class="text-xs text-slate-400 mt-1">QA software</p>
            <span class="inline-block mt-2 px-2 py-0.5 bg-green-500/20 text-green-300 text-xs rounded-full border border-green-500/20">Certificado</span>
          </div>
        </div>
      </div>

      <!-- Tarjeta 4: Diplomado PHP -->
      <div class="group relative bg-gradient-to-br from-slate-800/50 to-slate-900/50 backdrop-blur-sm border border-white/10 rounded-2xl p-6 hover:border-purple-400/40 transition-all duration-300 hover:shadow-2xl hover:shadow-purple-400/5">
        <div class="absolute -top-3 -right-3">
          <div class="w-12 h-12 bg-gradient-to-br from-purple-400 to-pink-500 rounded-full flex items-center justify-center shadow-lg shadow-purple-400/20">
            <svg class="w-6 h-6 text-slate-900" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
            </svg>
          </div>
        </div>
        <div class="flex items-start gap-4">
          <div class="flex-1">
            <h4 class="text-lg font-semibold text-white">Diplomado en Desarrollo PHP</h4>
            <p class="text-sm text-purple-400/80 font-medium">Politécnico Grancolombiano</p>
            <p class="text-xs text-slate-400 mt-1">Desarrollo con PHP</p>
            <span class="inline-block mt-2 px-2 py-0.5 bg-purple-500/20 text-purple-300 text-xs rounded-full border border-purple-500/20">Diplomado</span>
          </div>
        </div>
      </div>

    </div>
  </div>

</div>

<style>
  .skills-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1rem;
  }

  .actuales h3,
  .certificaciones h3 {
    position: relative;
    display: inline-block;
  }

  .actuales h3::after,
  .certificaciones h3::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 50%;
    transform: translateX(-50%);
    width: 60px;
    height: 3px;
    background: linear-gradient(90deg, transparent, #fbbf24, transparent);
    border-radius: 2px;
  }

  /* Animación de entrada para las tarjetas */
  .certificaciones .group {
    opacity: 0;
    animation: fadeInUp 0.6s ease-out forwards;
  }

  .certificaciones .group:nth-child(1) { animation-delay: 0.1s; }
  .certificaciones .group:nth-child(2) { animation-delay: 0.2s; }
  .certificaciones .group:nth-child(3) { animation-delay: 0.3s; }
  .certificaciones .group:nth-child(4) { animation-delay: 0.4s; }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Efecto de brillo en hover */
  .group::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 1rem;
    padding: 1px;
    background: linear-gradient(135deg, transparent 40%, rgba(255,255,255,0.05) 50%, transparent 60%);
    mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    mask-composite: exclude;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.5s ease;
  }

  .group:hover::before {
    opacity: 1;
  }
</style>