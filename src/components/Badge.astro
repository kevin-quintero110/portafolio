 /* HTML: <span class="badge"></span> */
.badge {
  width: 120px;
  height: 72px;
  border-bottom: 2px solid #ec1b1b00;
  margin-bottom: 15px;
  position: relative;
  overflow: hidden;
  display: inline-flex;
  align-items: flex-end;
  justify-content: center;
  background: transparent;
}
.badge::before {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 2px;
  background: transparent;
}
.badge::before {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 2px;
  background: linear-gradient(90deg, transparent 0%, rgba(70,32,83,0.2) 20%, #462053 45%, #462053 55%, rgba(70,32,83,0.2) 80%, transparent 100%);
  background-size: 120px 100%;
  animation: l3-0 .9s linear infinite;
}
.badge::after {
  display: none !important;
  content: none !important;
}
.dino {
  position: absolute;
  left: 50%;
  bottom: 3px;
  transform: translateX(-50%) translateY(0);
  animation: dino-bounce .9s ease-in-out infinite;
}
.dino svg {
  display: block;
  width: 32px;
  height: auto;
}
@keyframes l3-0 {
  0% {background-position: 0 0;}
  100% {background-position: -120px 0;}
}
@keyframes dino-bounce {
  0%, 100% { transform: translateX(-50%) translateY(0); }
  50% { transform: translateX(-50%) translateY(-10px); }
}
